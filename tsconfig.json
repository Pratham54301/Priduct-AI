{
  "compilerOptions": {
    "target": "ESNext", // ✅ Use the latest standard
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ], // ✅ Good for browser + modern JS
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true, // ✅ Disable for full ESModules support
    "module": "ESNext", // ✅ Ensure modern ESM
    "moduleResolution": "Bundler", // ✅ Works best with Next.js + Turbopack
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
